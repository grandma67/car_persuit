{
  "name": "car-pursuit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --host --mode https",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:browser": "node scripts/browser-check.mjs",
    "check:restart": "node scripts/browser-check.mjs --query \"seed=9&debug&gputrace&restarts=10&oldtown=1&chinatown=1&harbor=1&farm=1&slums=1&time=night&weather=rain\" --start 1500 --no-final --eval-file scripts/evals/restart.js",
    "t": "node scripts/test.mjs",
    "stats": "node scripts/run-ts.mjs scripts/district-stats.ts",
    "find": "node scripts/run-ts.mjs scripts/district-find.ts",
    "budget": "node scripts/run-ts.mjs scripts/district-budget.ts",
    "cops": "node scripts/cop-bench.mjs",
    "hash": "node scripts/run-ts.mjs scripts/city-hash.ts",
    "city": "node scripts/run-ts.mjs scripts/city.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.18.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24"
  }
}
